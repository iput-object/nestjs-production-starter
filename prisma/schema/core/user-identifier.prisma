// ============================================================
// core/user-identifier.prisma
//
// First-class contact identities (emails / phones).
// Source of truth for login, verification, and recovery.
// ============================================================

model UserIdentifier {
  id         String         @id @default(uuid())
  userId     String
  type       IdentifierType
  value      String // normalized: lowercased email / E.164 phone
  isPrimary  Boolean        @default(false)
  isVerified Boolean        @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@unique([userId, type, value])
  @@index([userId, type, isPrimary])
  @@map("user_identifiers")
}
